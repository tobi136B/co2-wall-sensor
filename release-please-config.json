{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "esphome/common/base.yaml"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "cad",
          "section": "Enclosure"
        },
        {
          "type": "ci",
          "section": "Build and CI",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build and CI",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        }
      ]
    }
  }
}
